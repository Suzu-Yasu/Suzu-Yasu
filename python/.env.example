# Notion インテグレーションのシークレットキー
# 取得方法: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 同期対象の Notion データベース ID（複数の場合はカンマ区切り）
# 取得方法: データベースページの URL に含まれる 32 文字の英数字
# 例: https://www.notion.so/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=...
#                             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ この部分
NOTION_DATABASE_IDS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# 出力先の Google Drive フォルダ ID
# 取得方法: フォルダを開いた URL の末尾の文字列
# 例: https://drive.google.com/drive/folders/zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz
#                                             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
GOOGLE_DRIVE_FOLDER_ID=zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz

# Google サービスアカウント認証情報（GitHub Actions 等の CI/CD 環境で使用）
# base64 エンコードした JSON キーファイルの内容を設定する
# コマンド例: base64 -w0 service-account-key.json
# ローカル実行時は空白のままにしてください（credentials.json + OAuth2 フローを使用）
GOOGLE_SERVICE_ACCOUNT_JSON=
